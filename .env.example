# ============================================================
# University Notice Board — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ---------- Notice Service Database (MySQL) ----------
NOTICE_DB_HOST=notice-db
NOTICE_DB_PORT=3306
NOTICE_DB_USER=notice_user
NOTICE_DB_PASSWORD=change_me_notice
NOTICE_DB_NAME=noticedb
NOTICE_DB_ROOT_PASSWORD=change_me_root_notice

# ---------- Feedback Service Database (PostgreSQL) ----------
FEEDBACK_DB_HOST=feedback-db
FEEDBACK_DB_PORT=5432
FEEDBACK_DB_USER=feedback_user
FEEDBACK_DB_PASSWORD=change_me_feedback
FEEDBACK_DB_NAME=feedbackdb

# ---------- Service Internal Ports ----------
GATEWAY_PORT=3000
NOTICE_SERVICE_PORT=3001
FEEDBACK_SERVICE_PORT=5000

# ---------- Gateway Routing ----------
NOTICE_SERVICE_URL=http://notice-service:3001
FEEDBACK_SERVICE_URL=http://feedback-service:5000

# ---------- Frontend ----------
FRONTEND_PORT=8080
